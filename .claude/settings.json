{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_CODE_SYNC_PLUGIN_INSTALL": "1",
    "CLAUDE_CODE_SYNC_PLUGIN_INSTALL_TIMEOUT_MS": "120000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(rm ~/)",
      "Bash(rm /)",
      "Bash(prisma db push)",
      "Bash(npx prisma db push)",
      "Bash(npm run db:push)",
      "Bash(bun run db:push)",
      "Bash(pnpm run db:push)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(dd if=/dev/zero of=/dev/sd*:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(chown -R /:*)",
      "Bash(chmod -R 0 /:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(systemctl poweroff:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git push:*)",
      "Bash(docker system prune -af:*)",
      "Bash(docker volume rm:*)",
      "Bash(prisma migrate reset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/destructive-command-block.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy-block.cjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tdk-core@tdk-plugin-marketplace": true,
    "tdk-memory@tdk-plugin-marketplace": true,
    "tdk-utils@tdk-plugin-marketplace": true,
    "tdk-test-api@tdk-plugin-marketplace": true,
    "context7-plugin@context7-marketplace": true
  },
  "effortLevel": "high"
}

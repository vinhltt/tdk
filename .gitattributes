# Auto detect text files and normalize line endings to LF
* text=auto

# Source files - Unix line endings
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.go text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Config/data files - Unix line endings
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Markup/documentation - Unix line endings
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.whl binary
*.so binary
*.exe binary
*.dll binary
*.dylib binary

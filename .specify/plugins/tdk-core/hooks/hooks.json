{
  "description": "Inject speckit development context on each prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dev-context-injector.cjs\""
          }
        ]
      }
    ]
  }
}

{
  "version": "3.2.0",
  "description": "Inject speckit development context and path-based rules",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook-gateway.cjs\" dev-context-injector"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook-gateway.cjs\" path-rule-injector"
          }
        ]
      }
    ]
  }
}

{
  "version": "1.0",
  "name": "tdk",
  "architecture": {
    "type": "monolith",
    "description": ""
  },
  "docs": {
    "path": ".specify/configurations"
  },
  "git": {
    "mainBranch": "develop",
    "prefixList": "tdk"
  },
  "changelog": {
    "exclude": [".specify/specs/**"]
  },
  "specs": {
    "root": ".specify",
    "defaultFolder": "specs",
    "ticketFormat": "^([a-zA-Z]+/)?([a-zA-Z]+)-([0-9]+)$"
  },
  "logLevel": "Debug",
  "rules": {
    "path": ".specify/rules"
  }
}
